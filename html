<!DOCTYPE html>
<html lang="tr">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Serbest</title>
    <!-- Tailwind CSS Tasarım Kütüphanesi -->
    <script src="https://cdn.tailwindcss.com"></script>
    <!-- Supabase Kütüphanesi -->
    <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
    <!-- PWA Manifest -->
    <link rel="manifest" href="manifest.json">
    <meta name="theme-color" content="#2563eb">
</head>
<body class="bg-gray-100 min-h-screen text-gray-800 pb-12">

    <!-- Üst Menü -->
    <nav class="bg-white shadow sticky top-0 z-50 mb-6">
        <div class="max-w-xl mx-auto px-4 py-3 flex justify-between items-center">
            <h1 class="text-xl font-bold text-blue-600">AlternatifAkış</h1>
            <div id="authNav" class="text-sm">
                <!-- JavaScript ile Giriş Durumuna Göre Dolacak -->
            </div>
        </div>
    </nav>

    <div class="max-w-xl mx-auto px-4 space-y-6">

        <!-- 1. GİRİŞ / KAYIT ALANI (Giriş Yapılmadıysa Görünür) -->
        <div id="authSection" class="bg-white p-6 rounded-xl shadow hidden">
            <h2 id="authTitle" class="text-lg font-bold mb-4 text-center">Giriş Yap / Kayıt Ol</h2>
            <input type="text" id="usernameInput" placeholder="Kullanıcı Adı" class="w-full p-3 border rounded-lg mb-3 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <input type="password" id="passwordInput" placeholder="Şifre" class="w-full p-3 border rounded-lg mb-4 text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none">
            <div class="flex gap-2">
                <button onclick="handleLogin()" class="flex-1 bg-blue-600 text-white p-3 rounded-lg font-medium hover:bg-blue-700 transition">Giriş Yap</button>
                <button onclick="handleRegister()" class="flex-1 bg-gray-800 text-white p-3 rounded-lg font-medium hover:bg-gray-900 transition">Kayıt Ol</button>
            </div>
        </div>

        <!-- 2. PROFİL DÜZENLEME & NOT EKLEME (Giriş Yapıldıysa Görünür) -->
        <div id="userProfileSection" class="bg-white p-6 rounded-xl shadow hidden space-y-4">
            <h2 class="font-bold text-lg text-blue-600">Profilim ve Durum Notum</h2>
            <div>
                <label class="text-xs text-gray-500 block mb-1">Notlar</label>
                <input type="text" id="myNoteInput" placeholder="Neler Var?" class="w-full p-2 border rounded text-sm mb-2">
                <button onclick="saveNote()" class="bg-gray-700 text-white text-xs px-4 py-2 rounded hover:bg-gray-800">Notu Güncelle</button>
            </div>
            <hr>
            <div>
                <label class="text-xs text-gray-500 block mb-1">Biyografi veya bağlantılar </label>
                <textarea id="myBioInput" placeholder="Hakkımda ve iletişim bilgilerim..." rows="2" class="w-full p-2 border rounded text-sm mb-2"></textarea>
                <button onclick="saveProfile()" class="bg-blue-600 text-white text-xs px-4 py-2 rounded hover:bg-blue-700">Profili Kaydet</button>
            </div>
        </div>

        <!-- 3. POST GÖNDERME KUTUSU (Giriş Yapıldıysa Görünür) -->
        <div id="postBoxSection" class="bg-white p-6 rounded-xl shadow hidden space-y-3">
            <h2 class="font-bold text-sm text-gray-600">Yeni Gönderi Paylaş</h2>
            <textarea id="postContentInput" placeholder="Neler oluyor?" rows="3" class="w-full p-3 border rounded-lg text-sm focus:ring-2 focus:ring-blue-500 focus:outline-none"></textarea>
            <input type="text" id="postIframeInput" placeholder="Spotify veya YouTube iFrame / Embed Kodu (İsteğe bağlı)" class="w-full p-2 border rounded text-xs">
            <button onclick="sendPost()" class="w-full bg-blue-600 text-white p-3 rounded-lg font-medium hover:bg-blue-700 transition">Yolla</button>
        </div>

        <!-- 4. İNSTAGRAM TARZI NOTLAR ÇUBUĞU -->
        <div class="bg-white p-4 rounded-xl shadow">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider mb-3">Aktif Notlar</h3>
            <div id="notesContainer" class="flex gap-4 overflow-x-auto pb-2">
                <span class="text-xs text-gray-400">Yükleniyor...</span>
            </div>
        </div>

        <!-- 5. AKIŞ (POSTLAR) -->
        <div class="space-y-4">
            <h3 class="text-xs font-bold text-gray-400 uppercase tracking-wider">Son Akış</h3>
            <div id="postsContainer" class="space-y-4">
                <p class="text-center text-gray-400 py-4">Gönderiler yükleniyor...</p>
            </div>
        </div>

    </div>

    <!-- JAVASCRIPT MİMARİSİ -->
    <script>
        // BURAYA KENDİ SUPABASE BİLGİLERİNİZİ YAZACAKSINIZ:
        const SUPABASE_URL = 'whalajhofdniunvzzpiq';
        const SUPABASE_ANON_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6IndoYWxhamhvZmRuaXVudnp6cGlxIiwicm9sZSI6ImFub24iLCJpYXQiOjE3OTE5MDU5MTYsImV4cCI6MjEwNzQ4MTkxNn0.YvcznfKb34VxzKwU4T5xQjLPgZLP1_pYTPExn8o3y5c';

        const _supabase = supabase.createClient(SUPABASE_URL, SUPABASE_ANON_KEY);
        let currentUser = null;

        async function checkUser() {
            const { data: { session } } = await _supabase.auth.getSession();
            currentUser = session ? session.user : null;
            renderAuthUI();
            fetchNotes();
            fetchPosts();
        }

        function renderAuthUI() {
            const authNav = document.getElementById('authNav');
            const authSection = document.getElementById('authSection');
            const userProfileSection = document.getElementById('userProfileSection');
            const postBoxSection = document.getElementById('postBoxSection');

            if (currentUser) {
                authNav.innerHTML = `<span class="text-gray-600 mr-3">Merhaba!</span> <button onclick="handleLogout()" class="text-red-500 font-medium">Çıkış Yap</button>`;
                authSection.classList.add('hidden');
                userProfileSection.classList.remove('hidden');
                postBoxSection.classList.remove('hidden');
            } else {
                authNav.innerHTML = `<span class="text-blue-600 font-medium">Giriş Yapılmadı</span>`;
                authSection.classList.remove('hidden');
                userProfileSection.classList.add('hidden');
                postBoxSection.classList.add('hidden');
            }
        }

        // Basit simüle edilmiş kullanıcı kayıt/giriş (Supabase Auth email-password tabanlı)
        async function handleRegister() {
            const username = document.getElementById('usernameInput').value.trim();
            const password = document.getElementById('passwordInput').value.trim();
            if (!username || !password) { alert('Kullanıcı adı ve şifre giriniz!'); return; }
            
            // Benzersiz e-posta uyduruyoruz ki Supabase kabul etsin
            const email = `${username.toLowerCase().replace(/\s+/g, '')}@alternatifislem.com`;

            const { data, error } = await _supabase.auth.signUp({ email, password });
            if (error) { alert('Kayıt Hatası: ' + error.message); return; }

            // Profili oluştur
            if (data.user) {
                await _supabase.from('profiles').insert([{ id: data.user.id, username }]);
            }
            alert('Kayıt başarılı! Şimdi giriş yapabilirsiniz.');
        }

        async function handleLogin() {
            const username = document.getElementById('usernameInput').value.trim();
            const password = document.getElementById('passwordInput').value.trim();
            if (!username || !password) { alert('Kullanıcı adı ve şifre giriniz!'); return; }

            const email = `${username.toLowerCase().replace(/\s+/g, '')}@alternatifislem.com`;
            const { error } = await _supabase.auth.signInWithPassword({ email, password });
            if (error) { alert('Giriş Hatası: Bilgileri kontrol edin.'); return; }
            location.reload();
        }

        async function handleLogout() {
            await _supabase.auth.signOut();
            location.reload();
        }

        async function saveNote() {
            const note_content = document.getElementById('myNoteInput').value.trim();
            if (!note_content) return;
            const { error } = await _supabase.from('user_notes').insert([{ user_id: currentUser.id, note_content }]);
            if (error) alert('Hata: ' + error.message);
            else { alert('Not güncellendi!'); document.getElementById('myNoteInput').value = ''; fetchNotes(); }
        }

        async function saveProfile() {
            const bio = document.getElementById('myBioInput').value.trim();
            const { error } = await _supabase.from('profiles').update({ bio }).eq('id', currentUser.id);
            if (error) alert('Hata: ' + error.message);
            else alert('Profil kaydedildi!');
        }

        async function sendPost() {
            const content = document.getElementById('postContentInput').value.trim();
            const iframe_code = document.getElementById('postIframeInput').value.trim();
            if (!content) { alert('Boş gönderi atılamaz!'); return; }

            const { error } = await _supabase.from('posts').insert([{ user_id: currentUser.id, content, iframe_code }]);
            if (error) { alert('Hata: ' + error.message); }
            else {
                document.getElementById('postContentInput').value = '';
                document.getElementById('postIframeInput').value = '';
                fetchPosts();
            }
        }

        async function fetchNotes() {
            const { data } = await _supabase.from('user_notes').select('*, profiles(username)').order('created_at', { ascending: false });
            const container = document.getElementById('notesContainer');
            if (!data || data.length === 0) { container.innerHTML = '<span class="text-xs text-gray-400">Henüz not yok.</span>'; return; }

            container.innerHTML = data.map(note => `
                <div class="flex flex-col items-center min-w-[70px]">
                    <div class="w-12 h-12 bg-blue-500 text-white rounded-full flex items-center justify-center font-bold text-lg mb-1 shadow">
                        ${note.profiles ? note.profiles.username[0].toUpperCase() : 'U'}
                    </div>
                    <span class="text-xs font-semibold text-gray-700 truncate w-16 text-center">@${note.profiles ? note.profiles.username : 'kullanıcı'}</span>
                    <div class="text-[10px] bg-gray-100 p-2 rounded mt-1 border text-center w-28 truncate">${escapeHtml(note.note_content)}</div>
                </div>
            `).join('');
        }

        async function fetchPosts() {
            const { data } = await _supabase.from('posts').select('*, profiles(username, bio)').order('created_at', { ascending: false });
            const container = document.getElementById('postsContainer');
            if (!data || data.length === 0) { container.innerHTML = '<p class="text-center text-gray-400">Henüz gönderi yok.</p>'; return; }

            container.innerHTML = data.map(post => `
                <div class="bg-white p-5 rounded-xl shadow space-y-2">
                    <div class="flex justify-between items-center">
                        <span class="font-bold text-blue-600 text-sm">@${post.profiles ? post.profiles.username : 'Anonim'}</span>
                        <span class="text-[10px] text-gray-400">${new Date(post.created_at).toLocaleString('tr-TR')}</span>
                    </div>
                    <p class="text-gray-700 text-sm whitespace-pre-wrap">${escapeHtml(post.content)}</p>
                    ${post.iframe_code ? `<div class="mt-2 overflow-hidden rounded-lg">${post.iframe_code}</div>` : ''}
                </div>
            `).join('');
        }

        function escapeHtml(text) {
            return text.replace(/&/g, "&amp;").replace(/</g, "&lt;").replace(/>/g, "&gt;");
        }

        checkUser();
    </script>
</body>
</html>
